# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/talenthub

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI - OpenRouter (https://openrouter.ai/keys)
# Free-model availability on OpenRouter rotates often (models get delisted with
# no warning). Before running, check https://openrouter.ai/models?max_price=0
# and pick a currently-live ID ending in ":free" — do not drop the ":free"
# suffix, that switches to the paid (billed) version of the same model.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=TalentHub
